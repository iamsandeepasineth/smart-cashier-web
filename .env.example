# Copy this file to .env and fill in your values.
# Everything here is built into the public website - never put passwords or tokens here.

# ── Contact ─────────────────────────────────────────────
# WhatsApp Business number, international format, digits only (072 125 1002 -> 94721251002)
VITE_WHATSAPP_NUMBER=94721251002
# Shown in the footer as tap-to-call. Leave empty to hide.
VITE_CONTACT_PHONE=+94 72 125 1002
# Shown in the footer as a mailto link. Leave empty to hide.
VITE_CONTACT_EMAIL=

# ── Download (GitHub Releases) ──────────────────────────
# Public releases repo. The site reads the latest release and links its .exe directly.
VITE_GITHUB_REPO=iamsandeepasineth/smart-cashier-releases
# Used if the GitHub lookup fails. A direct .exe link or the "latest" page.
VITE_DOWNLOAD_URL=https://github.com/iamsandeepasineth/smart-cashier-releases/releases/latest
# "All releases" link.
VITE_RELEASES_PAGE_URL=https://github.com/iamsandeepasineth/smart-cashier-releases/releases

# ── Hosting ─────────────────────────────────────────────
# "/" when the site sits at the root of its domain.
VITE_BASE_PATH=/
